{
  // Cloudflare Workers static-asset hosting for the built site.
  // Wrangler cannot auto-configure Vite 5, so this declares the deploy explicitly:
  // Every supported route has a built HTML file; unknown routes return a real 404.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "big-e-eats",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash"
  }
}
